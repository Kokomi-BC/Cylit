# PaperMind 环境配置示例
# 复制为 .env 后按需修改；所有变量前缀为 PR_
# 命令行方式：$env:PR_DB_PASSWORD="yourpass"; python cli/pr.py init

# ---------- 基础 ----------
PR_DEBUG=true
PR_HOST=127.0.0.1
PR_PORT=8710
PR_LOG_LEVEL=INFO

# ---------- 业务库（MySQL 8 推荐；无 MySQL 时改为 sqlite 可纯离线运行）----------
PR_DB_BACKEND=mysql
PR_DB_HOST=127.0.0.1
PR_DB_PORT=3306
PR_DB_USER=root
PR_DB_PASSWORD=root
PR_DB_NAME=papermind
PR_DB_ECHO=false

# ---------- 解析 ----------
PR_RENDER_DPI=150
PR_CROP_DPI=600
PR_PARSE_MAX_PAGES=0
# 扫描件兜底（影印 PDF 无文本层）：交视觉模型整页读页
PR_PARSE_VISION_ENABLED=true
PR_PARSE_VISION_DPI=200

# ---------- 逐段翻译（自适应并发，规划 §3.1 A3）----------
PR_TRANSLATE_CONCURRENCY=4
PR_TRANSLATE_MAX_CONCURRENCY=8
PR_TRANSLATE_MIN_CONCURRENCY=1
PR_TRANSLATE_BACKOFF_BASE=1.0
PR_TRANSLATE_BACKOFF_CAP=30.0
PR_TRANSLATE_BREAKER_THRESHOLD=8
PR_TRANSLATE_SKIP_TYPES=ref
PR_TRANSLATE_MAX_CONTEXT_CHARS=1200

# ---------- 任务系统 ----------
PR_TASK_WORKER_COUNT=2
PR_TASK_POLL_INTERVAL=0.8
PR_TASK_LEASE_SECONDS=120

# ---------- 模型与密钥 ----------
# 密钥不写在 .env 里，而是放在 data/secrets/<secret_ref> 文件中（规划 §12.2）
# PR_SECRET_DEEPSEEK_KEY=sk-xxx        # 也可用环境变量方式提供
PR_ALLOW_GENERAL_KNOWLEDGE=false
